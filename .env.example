AIRFLOW_UID=50000

# --- Postgres ---
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_postgres_password

# --- Airflow core secrets ---
AIRFLOW__CORE__FERNET_KEY=generate_with_python
AIRFLOW__API_AUTH__JWT_SECRET=generate_with_openssl
AIRFLOW__API_AUTH__JWT_ISSUER=molflow

# --- Airflow admin UI account (dev only) ---
_AIRFLOW_WWW_USER_USERNAME=your_airflow_username
_AIRFLOW_WWW_USER_PASSWORD=your_airflow_password

# --- MinIO ---
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# --- MS Teams webhook ---
MS_TEAMS_WEBHOOK_URL=your_ms_teams_webhook_url
